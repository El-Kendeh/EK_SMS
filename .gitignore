# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — ignore in repo root and subfolders (e.g. backend_node)
node_modules/
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store

# ── Environment / secrets — ignore ALL .env variants, keep only templates ──
# Catches .env, .env.render, .env.save, .env.*.local, and any future secret env file.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
# Public CRA build config (REACT_APP_* only, no secrets) — intentionally tracked:
!.env.frontend
!.env.production
DEVELOPER_CREDENTIALS.md
# Local maintenance / debug scripts that embed credentials or reset passwords
backend_node/reset_*_passwords.js
backend_node/debug_*.js

# Claude Code (local AI tooling - never push to repo)
.claude/

#Ignore this folder  don't push
public/stich-refrence/
public/stich-refrence/constitch (5)

# Python
**/__pycache__/
.venv/
venv/
*.py[cod]
*$py.class
*.sqlite3
logs/
**/logs/

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel local config
.vercel/

# Django runtime logs
eksms/logs/

# Local assets not for version control
public/docu/
public/image/adds-on/
public/school-admin-refrence-UI/
public/stich-refrence/

# ── Django generated / uploaded files ─────────────────────────────
# Collected static files (generated by collectstatic — not source)
eksms/staticfiles/

# User-uploaded media (personal data — never commit)
eksms/media/
# Node runtime-uploaded media at the repo ROOT (stray output — the backend writes
# to backend_node/uploads/; this /uploads/ is not source). Never commit.
/uploads/

# ── Debug & utility scripts (local dev only) ──────────────────────
eksms/check_*.py
eksms/test_migrate.py

# ── Debug output files ────────────────────────────────────────────
eksms/grep*.txt
eksms/schools_grep*.txt
eksms/*_output*.txt
eksms/*_output_*.txt

# ── Office / document files ───────────────────────────────────────
eksms/*.docx
eksms/~$*.docx
*.docx
~$*.docx

# ── Internal documentation (not for public repo) ──────────────────
SYSTEM_DOCS.md
public/EK-SMS-Complete-System-Workflow.md

